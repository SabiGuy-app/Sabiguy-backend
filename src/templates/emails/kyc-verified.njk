<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>KYC Verification Complete</title>
</head>
<body style="margin:0; padding:0; background:#f4f7f4; font-family:Arial,Helvetica,sans-serif; color:#1f2937;">

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="padding:32px 12px;">
    <tr>
      <td align="center">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;">

          <!-- HEADER -->
          <tr>
            <td align="center" style="background:linear-gradient(150deg, #1a6b35 0%, #1d7a3c 55%, #155f2d 100%); border-radius:16px 16px 0 0; padding:32px 36px 28px;">
              {% if logoUrl %}
              <img src="{{ logoUrl }}" alt="{{ brandName }}" style="max-height:48px; width:auto; display:block; margin:0 auto 16px;" />
              {% else %}
              <div style="font-weight:700; font-size:24px; letter-spacing:1px; color:#ffffff; margin-bottom:16px;">{{ brandName }}</div>
              {% endif %}

              <div style="font-size:48px; margin-bottom:12px;">✅</div>
              <h2 style="margin:0 0 8px; font-size:24px; line-height:1.3; color:#ffffff; font-weight:700;">KYC Verification Approved!</h2>
              <p style="margin:0; font-size:14.5px; color:#c8e6c9; line-height:1.6;">
                Your account is now fully verified and ready to start earning
              </p>
            </td>
          </tr>

          <!-- ORANGE ACCENT STRIPE -->
          <tr>
            <td style="background:#f47920; height:4px; font-size:0; line-height:0;">&nbsp;</td>
          </tr>

          <!-- BODY -->
          <tr>
            <td style="background:#ffffff; padding:36px 36px 28px;">

              <p style="margin:0 0 24px; font-size:15px; line-height:1.7; color:#374151;">
                Hi {{ providerName }},
              </p>

              <p style="margin:0 0 24px; font-size:15px; line-height:1.7; color:#374151;">
                Great news! Our team has reviewed and verified your account. Your KYC (Know Your Customer) verification is now complete and approved.
              </p>

              <p style="margin:0 0 24px; font-size:15px; line-height:1.7; color:#374151;">
              Additionally, you will receive a rider bonus for every ride you complete. Pleae note that you won't be able to withdraw the money until you complete at least five ride.
              </p>

              <!-- SUCCESS BOX -->
              <div style="margin:0 0 28px; background:#f0fdf4; border-left:4px solid #1a6b35; padding:20px 24px; border-radius:8px;">
                <h3 style="margin:0 0 12px; font-size:16px; font-weight:700; color:#1a6b35;">You can now:</h3>
                <ul style="margin:0; padding-left:20px; color:#374151; font-size:14px; line-height:1.8;">
                  <li>✓ Toggle on your availability button</li>
                  <li>✓ Stay online and active on the platform</li>
                  <li>✓ Receive notifications for job opportunities</li>
                  <li>✓ Accept and manage bookings</li>
                </ul>
              </div>

              <p style="margin:0 0 24px; font-size:15px; line-height:1.7; color:#374151;">
                Start listening for hire alerts and get ready to serve your customers! Keep your profile updated and maintain a high service standard.
              </p>

              {% if note %}
              <p style="margin:0 0 24px; font-size:14px; line-height:1.7; color:#666; background:#f9fafb; padding:16px; border-radius:8px;">
                <strong>Admin Note:</strong> {{ note }}
              </p>
              {% endif %}

              <!-- CTA BUTTON -->
              <div style="text-align:center; margin:32px 0;">
                <a href="{{ platformUrl or 'https://sabiguy.com' }}" style="display:inline-block; background:#1a6b35; color:#ffffff; padding:14px 36px; border-radius:8px; text-decoration:none; font-weight:700; font-size:15px;">
                  Go to Dashboard
                </a>
              </div>

            </td>
          </tr>

          <!-- FOOTER -->
          <tr>
            <td style="background:#f9fafb; border-radius:0 0 16px 16px; padding:28px 36px; border-top:1px solid #e5e7eb;">
              <p style="margin:0 0 12px; font-size:13px; color:#6b7280; line-height:1.6; text-align:center;">
                If you have any questions about your verification, please contact our support team.
              </p>
              <p style="margin:0; font-size:12px; color:#9ca3af; text-align:center; line-height:1.5;">
                © {{ year }} {{ brandName }}. All rights reserved.
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>

</body>
</html>
