<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>KYC Verification Update</title>
</head>
<body style="margin:0; padding:0; background:#f4f7f4; font-family:Arial,Helvetica,sans-serif; color:#1f2937;">

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="padding:32px 12px;">
    <tr>
      <td align="center">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;">

          <!-- HEADER -->
          <tr>
            <td align="center" style="background:linear-gradient(150deg, #b91c1c 0%, #dc2626 55%, #991b1b 100%); border-radius:16px 16px 0 0; padding:32px 36px 28px;">
              {% if logoUrl %}
              <img src="{{ logoUrl }}" alt="{{ brandName }}" style="max-height:48px; width:auto; display:block; margin:0 auto 16px;" />
              {% else %}
              <div style="font-weight:700; font-size:24px; letter-spacing:1px; color:#ffffff; margin-bottom:16px;">{{ brandName }}</div>
              {% endif %}

              <div style="font-size:48px; margin-bottom:12px;">⚠️</div>
              <h2 style="margin:0 0 8px; font-size:24px; line-height:1.3; color:#ffffff; font-weight:700;">KYC Verification Not Approved</h2>
              <p style="margin:0; font-size:14.5px; color:#fecaca; line-height:1.6;">
                We need more information to complete your verification
              </p>
            </td>
          </tr>

          <!-- ORANGE ACCENT STRIPE -->
          <tr>
            <td style="background:#f47920; height:4px; font-size:0; line-height:0;">&nbsp;</td>
          </tr>

          <!-- BODY -->
          <tr>
            <td style="background:#ffffff; padding:36px 36px 28px;">

              <p style="margin:0 0 24px; font-size:15px; line-height:1.7; color:#374151;">
                Hi {{ providerName }},
              </p>

              <p style="margin:0 0 24px; font-size:15px; line-height:1.7; color:#374151;">
                Thank you for submitting your KYC (Know Your Customer) verification. Our team has reviewed your submission, and unfortunately, we could not approve it at this time.
              </p>

              <!-- ISSUE BOX -->
              <div style="margin:0 0 28px; background:#fef2f2; border-left:4px solid #dc2626; padding:20px 24px; border-radius:8px;">
                <h3 style="margin:0 0 12px; font-size:16px; font-weight:700; color:#991b1b;">Reason:</h3>
                <p style="margin:0; font-size:14px; line-height:1.7; color:#374151;">
                  {{ reason or "The information provided does not meet our verification requirements. Please review the issues below and resubmit." }}
                </p>
              </div>

              {% if note %}
              <div style="margin:0 0 28px; background:#f9fafb; border:1px solid #e5e7eb; padding:16px; border-radius:8px;">
                <p style="margin:0; font-size:14px; line-height:1.7; color:#374151;">
                  <strong>Details from our team:</strong><br>
                  {{ note }}
                </p>
              </div>
              {% endif %}

              <!-- NEXT STEPS -->
              <div style="margin:0 0 28px; background:#f0fdf4; border-left:4px solid #1a6b35; padding:20px 24px; border-radius:8px;">
                <h3 style="margin:0 0 12px; font-size:16px; font-weight:700; color:#1a6b35;">What you can do:</h3>
                <ul style="margin:0; padding-left:20px; color:#374151; font-size:14px; line-height:1.8;">
                  <li>Review the feedback provided</li>
                  <li>Prepare the correct or additional documents</li>
                  <li>Resubmit your KYC verification through your dashboard</li>
                  <li>Contact our support team if you have questions</li>
                </ul>
              </div>

              <p style="margin:0 0 24px; font-size:15px; line-height:1.7; color:#374151;">
                We're here to help! If you believe this decision was made in error, or if you have questions about what was needed, please reach out to our support team immediately.
              </p>

              <!-- CTA BUTTON -->
              <div style="text-align:center; margin:32px 0;">
                <a href="{{ platformUrl or 'https://sabiguy.com' }}/dashboard/kyc" style="display:inline-block; background:#1a6b35; color:#ffffff; padding:14px 36px; border-radius:8px; text-decoration:none; font-weight:700; font-size:15px;">
                  Resubmit KYC
                </a>
              </div>

            </td>
          </tr>

          <!-- FOOTER -->
          <tr>
            <td style="background:#f9fafb; border-radius:0 0 16px 16px; padding:28px 36px; border-top:1px solid #e5e7eb;">
              <p style="margin:0 0 12px; font-size:13px; color:#6b7280; line-height:1.6; text-align:center;">
                Need help? Contact our support team at {{ supportEmail or 'support@sabiguy.com' }}
              </p>
              <p style="margin:0; font-size:12px; color:#9ca3af; text-align:center; line-height:1.5;">
                © {{ year }} {{ brandName }}. All rights reserved.
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>

</body>
</html>
