<!doctype html>
<html><body style="font-family:Arial,sans-serif;color:#1f2937;line-height:1.6">
  <h2>Product submitted for approval</h2>
  <p>A {{ accountType }} account submitted a product that needs review.</p>
  <ul>
    <li><strong>Product:</strong> {{ productName }}</li>
    <li><strong>Price:</strong> {{ currency }} {{ price }}</li>
    <li><strong>Account:</strong> {{ accountName }} ({{ accountEmail }})</li>
    <li><strong>Description:</strong> {{ description }}</li>
  </ul>
  <p>Sign in to the admin dashboard to approve or reject this product.</p>
  <small>© {{ year }} SabiGuy</small>
</body></html>
