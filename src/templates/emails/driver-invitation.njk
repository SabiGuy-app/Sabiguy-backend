<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Fleet Invitation</title>
</head>
<body style="margin:0; padding:0; background:#f4f7f4; font-family:Arial,Helvetica,sans-serif; color:#1f2937;">

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="padding:32px 12px;">
    <tr>
      <td align="center">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;">

          <!-- HEADER -->
          <tr>
            <td align="center" style="background:linear-gradient(150deg, #1a6b35 0%, #1d7a3c 55%, #155f2d 100%); border-radius:16px 16px 0 0; padding:32px 36px 28px;">
              {% if logoUrl %}
              <img src="{{ logoUrl }}" alt="{{ brandName }}" style="max-height:48px; width:auto; display:block; margin:0 auto 16px;" />
              {% else %}
              <div style="font-weight:700; font-size:24px; letter-spacing:1px; color:#ffffff; margin-bottom:16px;">{{ brandName }}</div>
              {% endif %}

              <div style="font-size:48px; margin-bottom:12px;">🚚</div>
              <h2 style="margin:0 0 8px; font-size:24px; line-height:1.3; color:#ffffff; font-weight:700;">You've Been Invited to Join a Fleet</h2>
            </td>
          </tr>

          <!-- ORANGE ACCENT STRIPE -->
          <tr>
            <td style="background:#f47920; height:4px; font-size:0; line-height:0;">&nbsp;</td>
          </tr>

          <!-- BODY -->
          <tr>
            <td style="background:#ffffff; padding:36px 36px 28px;">

              <p style="margin:0 0 24px; font-size:15px; line-height:1.7; color:#374151;">
                Hi {{ driverName }},
              </p>

              <p style="margin:0 0 24px; font-size:15px; line-height:1.7; color:#374151;">
                You have been invited to join <strong>{{ businessName }}</strong> as a driver. Accept or decline by clicking the link below.
              </p>

              <!-- CTA BUTTON -->
              <div style="text-align:center; margin:32px 0;">
                <a href="{{ inviteLink }}" style="display:inline-block; background:#1a6b35; color:#ffffff; padding:14px 36px; border-radius:8px; text-decoration:none; font-weight:700; font-size:15px;">
                  Accept or Decline Invitation
                </a>
              </div>

              <p style="margin:0 0 24px; font-size:13px; line-height:1.7; color:#6b7280;">
                This invitation link expires in {{ expiryDays }} day{{ "s" if expiryDays != 1 else "" }}. If you weren't expecting this, you can safely ignore this email.
              </p>

            </td>
          </tr>

          <!-- FOOTER -->
          <tr>
            <td style="background:#f9fafb; border-radius:0 0 16px 16px; padding:28px 36px; border-top:1px solid #e5e7eb;">
              <p style="margin:0; font-size:12px; color:#9ca3af; text-align:center; line-height:1.5;">
                © {{ year }} {{ brandName }}. All rights reserved.
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>

</body>
</html>
